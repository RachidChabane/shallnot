#!/usr/bin/env bash
# Cross-compile release archives and their checksums into dist/.
# Usage: script/dist <version>
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

VERSION="${1:?usage: script/dist <version>}"
TARGETS="linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 windows/amd64 windows/arm64"

rm -rf dist
mkdir -p dist
for target in $TARGETS; do
  os="${target%/*}"
  arch="${target#*/}"
  binary="shallnot"
  [ "$os" = "windows" ] && binary="shallnot.exe"
  stage="dist/stage/${os}_${arch}"
  mkdir -p "$stage"
  CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" go build -trimpath \
    -ldflags "-s -w -X github.com/RachidChabane/shallnot/internal/version.injected=${VERSION}" \
    -o "$stage/$binary" ./cmd/shallnot
  cp LICENSE README.md "$stage/"
  tar -C "$stage" -czf "dist/shallnot_${os}_${arch}.tar.gz" "$binary" LICENSE README.md
  if [ "$os" = "windows" ]; then
    (cd "$stage" && zip -q "../../shallnot_${os}_${arch}.zip" "$binary" LICENSE README.md)
  fi
done
rm -rf dist/stage

cd dist
if command -v sha256sum >/dev/null 2>&1; then
  sha256sum shallnot_* > checksums.txt
else
  shasum -a 256 shallnot_* > checksums.txt
fi
