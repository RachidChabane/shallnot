#!/usr/bin/env bash
# Record build/session.gif and build/session.png: a real agent session in a
# project equipped by `shallnot init`, given a plain feature request.
# CAPTURE_SESSION is the path of a capture-session script taking
# --cwd --prep --prompt --until --out --gif (it drives a terminal window and
# records the screen). Needs the claude CLI and shallnot on PATH.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

capture="${CAPTURE_SESSION:?set CAPTURE_SESSION to the path of a capture-session script}"
script/build
mkdir -p build
"$capture" \
  --cwd "$HOME/.cache/shallnot-demo/password-policy" \
  --prep script/demo.d/session-prep.sh \
  --prompt "Passwords that contain the account's username should be rejected. Can you add that?" \
  --until "shallnot|gate" \
  --out build/session.png --gif build/session.gif
