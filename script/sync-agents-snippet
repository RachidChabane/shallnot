#!/usr/bin/env bash
# Derive skill/AGENTS.snippet.md from skill/shallnot/SKILL.md: drop the front
# matter and demote every heading by one level.
# With --check, fail if the committed snippet differs.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

derived="$(awk '
  NR == 1 && $0 == "---" { front = 1; next }
  front && $0 == "---"   { front = 0; skip_blank = 1; next }
  front                  { next }
  skip_blank && $0 == "" { next }
  { skip_blank = 0 }
  /^#+ /                 { print "#" $0; next }
  { print }
' skill/shallnot/SKILL.md)"

if [ "${1:-}" = "--check" ]; then
  if [ "$derived" != "$(cat skill/AGENTS.snippet.md)" ]; then
    echo "skill/AGENTS.snippet.md is out of date: run script/sync-agents-snippet" >&2
    exit 1
  fi
  exit 0
fi
printf '%s\n' "$derived" > skill/AGENTS.snippet.md
