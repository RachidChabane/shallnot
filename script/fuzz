#!/usr/bin/env bash
# Fuzz each parser for FUZZTIME (default 20s).
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

FUZZTIME="${FUZZTIME:-20s}"
go test ./internal/domain -run '^$' -fuzz FuzzFindBracketTags -fuzztime "$FUZZTIME"
go test ./internal/adapters/spec -run '^$' -fuzz FuzzMarkdown -fuzztime "$FUZZTIME"
go test ./internal/adapters/junitxml -run '^$' -fuzz FuzzReader -fuzztime "$FUZZTIME"
