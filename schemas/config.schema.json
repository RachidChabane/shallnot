{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RachidChabane/shallnot/main/schemas/config.schema.json",
  "title": "shallnot configuration",
  "description": "The shallnot.yaml configuration file. Relative paths are resolved against the file's directory.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1,
      "description": "Configuration format version."
    },
    "id_pattern": {
      "type": "string",
      "description": "Regular expression (RE2) a whole requirement ID must match. It must not match text containing '~', ',', ']' or whitespace."
    },
    "specs": {
      "type": "array",
      "description": "Known specs: files, directories or globs.",
      "items": {
        "type": "string"
      }
    },
    "focus": {
      "type": "array",
      "description": "Spec files whose requirements the run must find covered. They are known specs too.",
      "items": {
        "type": "string"
      }
    },
    "focus_ids": {
      "type": "array",
      "description": "Globs on requirement IDs the run must find covered.",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "description": "Test source root directories scanned for tags.",
      "items": {
        "type": "string"
      }
    },
    "results": {
      "type": "array",
      "description": "JUnit XML results: files, directories or globs.",
      "items": {
        "type": "string"
      }
    },
    "exclude": {
      "type": "array",
      "description": "Globs of source paths the scan ignores, matched against the path as reported.",
      "items": {
        "type": "string"
      }
    },
    "test_commands": {
      "type": "array",
      "description": "Command lines that `shallnot gate` runs through the platform shell, in order, in the config file's directory, before checking. Their exit status does not affect the verdict; every results file must be written by that run.",
      "items": {
        "type": "string"
      }
    },
    "default_excludes": {
      "type": "boolean",
      "description": "Whether dependency and build directories are ignored by the scan. Default true."
    },
    "advisory": {
      "type": "boolean",
      "description": "Report everything but always exit 0. Default false."
    },
    "strict": {
      "type": "boolean",
      "description": "Treat untagged tests as errors. Default false."
    },
    "fail_on": {
      "type": "string",
      "description": "Lowest blocking severity. Default error.",
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "severities": {
      "type": "object",
      "description": "Severity per finding category.",
      "properties": {
        "uncovered_requirement": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "failed_requirement": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "skipped_requirement": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "not_run_requirement": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "failing_bound_test": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "tag_not_in_results": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "orphan_tag": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "revision_mismatch": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "malformed_tag": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "unjustified_non_testable": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "bound_non_testable": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "duplicate_id": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "malformed_requirement": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "untagged_test": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "unknown_dimension": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "malformed_example": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "detached_example": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "statement_changed": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "stale_proof": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "malformed_proof": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "correct_code_fails": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "surviving_valid_mutant": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "no_valid_mutant": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "no_killed_valid_mutant": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "escalated_mutant": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "misaligned_test": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "mutation_sensitive_test": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "example_failed": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "completeness_question": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "awaiting_host": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "awaiting_proof": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "awaiting_host_judgment": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        "host_unresponsive": {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        }
      },
      "additionalProperties": false
    },
    "proofs": {
      "type": "object",
      "description": "Consumption of the verified proof set that spec-proof modules write. Absent: no proof is read.",
      "properties": {
        "verified_dir": {
          "type": "string",
          "description": "Directory holding the verified proof set and its manifest.json, relative to the config file's directory. Default .spec-proof/verified."
        },
        "require": {
          "type": "array",
          "description": "Proof kinds that every criterion in focus must hold a valid proof of, by kind or by predicate type URI. A required kind with no valid proof is a stale_proof finding, never a pass. Completeness is advisory and cannot be required.",
          "items": {
            "type": "string",
            "enum": [
              "alignment",
              "discriminating-power",
              "https://rachid-chabane.com/attestations/alignment/v1",
              "https://rachid-chabane.com/attestations/discriminating-power/v1"
            ]
          }
        },
        "code": {
          "type": "array",
          "description": "Files, directories or globs that a proof's code_tree descriptors may name. A descriptor outside them makes the proof stale, so without entries a proof that names a code_tree file is stale.",
          "items": {
            "type": "string"
          }
        },
        "trust": {
          "enum": [
            "signed",
            "local"
          ],
          "description": "signed admits only statements produced by CI in a set the signature verifier wrote; local also admits unsigned local statements and is feedback, never proof. Default signed."
        },
        "thresholds": {
          "type": "object",
          "description": "Confidence at which a judged claim has power.",
          "properties": {
            "validity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence of a mutant validity that blocks or earns pass credit. Default 0.7."
            },
            "alignment": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confidence of an ALIGNED verdict that clears alignment. Default 0.7."
            }
          },
          "additionalProperties": false
        },
        "escalation": {
          "enum": [
            "error",
            "warning"
          ],
          "description": "Whether a finding that escalates a judged signal fails the verdict (error) or is only reported (warning). A severity set for a category wins. Default error."
        },
        "signed_pass_basis": {
          "enum": [
            "executed-only",
            "corroborated",
            "judged"
          ],
          "description": "Evidence a signed pass may rest on: executed evidence alone, judged claims that name their executed corroboration, or judged claims alone. Default corroborated."
        },
        "min_isolation": {
          "enum": [
            "restricted-attested",
            "restricted",
            "restricted-unverified",
            "unrestricted",
            "inline"
          ],
          "description": "Isolation floor below which a judged response earns no pass credit but keeps its block power. Default restricted."
        },
        "max_host_exclusions": {
          "type": "integer",
          "minimum": 0,
          "description": "Survivors a criterion may exclude on a judgment alone. Default 2."
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false
}
